<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ОСНОВНОЙ КОНТЕНТ (Обертка FrameLayout для экрана загрузки) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Фон -->
            <com.example.voicecontrol.PixelBackgroundView
                android:id="@+id/pixelBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Бургер -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_burger_bg"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#B39DDB"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Заголовок -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/text_bg"
                android:fontFamily="monospace"
                android:text="VOICE CONTROL"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/btnToggle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <!-- Кнопка ACTIVATE -->
            <Button
                android:id="@+id/btnToggle"
                android:layout_width="220dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_bg"
                android:fontFamily="monospace"
                android:text="ACTIVATE"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/tvStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

            <!-- Статус -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/text_bg"
                android:fontFamily="monospace"
                android:text="[ STATUS: OFFLINE ]"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnToggle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ЭКРАН ЗАГРУЗКИ -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ ИНИЦИАЛИЗАЦИЯ СИСТЕМ ]"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:indeterminateTint="#B39DDB"/>

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Загрузка нейросетей..."
                    android:textColor="#AAAAAA"
                    android:fontFamily="monospace"/>

            </LinearLayout>
        </FrameLayout>

    </FrameLayout> <!-- Конец обертки FrameLayout -->

    <!-- ВЫДВИЖНОЕ МЕНЮ (ПОЛНОСТЬЮ ВОССТАНОВЛЕНО) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111111"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="КОМАНДЫ"
                android:textColor="#B39DDB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• ЭХО (активация)\n• ВПЕРЕД / ДАЛЬШЕ / СКИП\n• НАЗАД / ВЕРНИ\n• ПАУЗА / СТОП / ИГРАТЬ\n• ГРОМЧЕ / ТИШЕ\n• МАКСИМУМ / МИНИМУМ\"
                android:textColor="#AAAAAA"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАСТРОЙКИ"
                android:textColor="#B39DDB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Анимация фона"
                android:textColor="@android:color/white"
                android:fontFamily="monospace"
                android:textSize="14sp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAnimation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnRecordVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_bg"
                android:fontFamily="monospace"
                android:text="ПЕРЕЗАПИСАТЬ ГОЛОС"
                android:textColor="@android:color/white" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvGithub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GITHUB (ОБРАТНАЯ СВЯЗЬ)"
                android:textColor="#B39DDB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>